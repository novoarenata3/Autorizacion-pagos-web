# Base de Datos PostgreSQL
POSTGRES_DB=pagos_cooperativa_db
POSTGRES_USER=pagos_admin
POSTGRES_PASSWORD=secure_payment_pass
DATABASE_URL=jdbc:postgresql://db:5432/pagos_cooperativa_db

# Redis (Control de Idempotencia)
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ (Worker Asíncrono y Notificaciones)
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=adminpass

# Configuración de Timeouts para Banco Externo (ms)
EXTERNAL_BANK_TIMEOUT_MS=3000
